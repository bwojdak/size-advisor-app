# Size Advisor — wymagane zmienne środowiskowe.
# Skopiuj do `.env` (lokalnie) lub ustaw w panelu hostingu. NIE commituj `.env`.

# --- Shopify (z Partner Dashboard / `shopify app env pull`) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://twoja-domena-produkcyjna
# MUSI dokładnie odpowiadać `scopes` w shopify.app.*.toml — ten env var jest
# tym, co faktycznie żąda się przy OAuth (patrz shopify.server.ts), toml sam
# w sobie tego nie wymusza w runtime. Rozjazd = realne błędy "insufficient
# scope" na produkcji (np. webhooki orders/refunds potrzebują read_orders).
SCOPES=read_orders,write_metaobject_definitions,write_metaobjects,write_products
# SHOP_CUSTOM_DOMAIN=   # opcjonalne, jeśli sklep ma własną domenę

# --- Baza danych ---
# Lokalnie: SQLite. Produkcja: Postgres, np. postgresql://user:pass@host:5432/db
DATABASE_URL=file:dev.sqlite

# --- Model AI ---
AI_PROVIDER=openai            # "openai" albo "gemini"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini      # opcjonalne, domyślnie gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# --- Billing ---
# KRYTYCZNE PRZED PUBLIKACJĄ: domyślnie WYŁĄCZONE (obciążenia testowe, karta
# merchanta nigdy nie jest realnie obciążana — patrz BILLING_IS_TEST w
# shopify.server.ts). Dopóki to nie jest "true" na produkcji, WSZYSCY płacący
# merchanci dostają subskrypcję za darmo (Shopify nigdy ich nie obciąży).
BILLING_LIVE=false            # ustaw "true" na produkcji dopiero przy publikacji

# --- Środowisko ---
NODE_ENV=production
