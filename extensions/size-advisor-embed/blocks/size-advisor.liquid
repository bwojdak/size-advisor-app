<script>
  async function initSizeAdvisor() {
    if (window.__sizeAdvisorInitialized) return;
    window.__sizeAdvisorInitialized = true;

    const I18N = window.__SA_I18N || {};
    const SA_ALL = window.__SA_I18N_ALL || {};
    const withSize = (tpl, size) => String(tpl || '').replace('[size]', size);
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));

    const saVariants = {{ product.variants | json }};

    const container = document.getElementById('size-advisor-container');
    const saRoot = container ? container.closest('.sa-root') : null;

    // Język widżetu: domyślnie dziedziczy po języku sklepu (jeśli PL/EN),
    // admin może wymusić w Ustawieniach, a kupujący przełączyć ikoną 🌐.
    const saStoreLang = (function () {
      const loc = String(window.__SA_LOCALE || '').slice(0, 2).toLowerCase();
      return loc === 'pl' || loc === 'en' ? loc : 'en';
    })();
    let saLang = saStoreLang;

    // Tłumaczenie z fallbackiem: aktywna tabela → pełny zestaw dla języka →
    // literał. Pomija „translation missing" ze starych motywów bez nowych kluczy.
    const t = (key, fallback) => {
      const v = I18N[key];
      if (v != null && !/^translation missing/i.test(v)) return v;
      const tbl = SA_ALL[saLang];
      if (tbl && tbl[key] != null) return tbl[key];
      return fallback;
    };
    // Prawdziwa implementacja podstawiana w initSizeAdvisor, gdy DOM już jest.
    // Zadeklarowane tu, bo applyI18n() woła to przy przełączeniu języka.
    let applyUnits = function () {};

    function applyI18n(lang) {
      const tbl = SA_ALL[lang];
      if (!tbl) return;
      saLang = lang;
      Object.assign(I18N, tbl);
      const scope = saRoot || document;
      scope.querySelectorAll('[data-i18n]').forEach((el) => {
        const v = tbl[el.getAttribute('data-i18n')];
        if (v != null) el.textContent = v;
      });
      scope.querySelectorAll('[data-i18n-ph]').forEach((el) => {
        const v = tbl[el.getAttribute('data-i18n-ph')];
        if (v != null) el.setAttribute('placeholder', v);
      });
      scope.querySelectorAll('[data-i18n-aria]').forEach((el) => {
        const v = tbl[el.getAttribute('data-i18n-aria')];
        if (v != null) el.setAttribute('aria-label', v);
      });
      try { localStorage.setItem('sa-lang', lang); } catch (e) {}
      // Etykiety wzrostu/wagi mają dopisaną jednostkę — odtwórz po podmianie i18n.
      applyUnits();
    }

    let allowAddToCart = false;
    let askFitPref = false;
    let askGarment = false;
    let garmentDims = [];
    let autoSize = false;
    // Ostatnie policzone dane — powtórne „Oblicz" z tymi samymi wartościami, gdy
    // wynik już jest na ekranie, nie wysyła kolejnego zapytania.
    let lastCalcKey = null;
    try {
      const statusRes = await fetch(
        '/apps/size-advisor/status?v=' + Date.now() + '&productId=' + encodeURIComponent({{ product.id | json }}),
        { cache: 'no-store' },
      );
      const statusData = await statusRes.json();

      if (!statusData.enabled) {
        return;
      }

      allowAddToCart = statusData.addToCart === true;
      autoSize = statusData.autoSize === true;
      askFitPref = statusData.fitPreference === true;
      if (askFitPref) {
        const fw = document.getElementById('sa-fit-wrap');
        if (fw) fw.hidden = false;
      }

      garmentDims = Array.isArray(statusData.garmentDims) ? statusData.garmentDims : [];
      // Sekcja pokazuje się tylko gdy TA tabela ma czym porównać ubranie
      // referencyjne (produkt bez tabeli / nieodzieżowy → garmentDims puste).
      askGarment = statusData.garmentMatch === true && garmentDims.length > 0;
      if (askGarment) {
        const gw = document.getElementById('sa-garment-wrap');
        if (gw) gw.hidden = false;
        const gt = document.getElementById('sa-garment-toggle');
        const gf = document.getElementById('sa-garment-fields');
        const dyn = document.getElementById('sa-garment-dyn');
        if (dyn) {
          const dimLabel = {
            chest: 'garment_dim_chest',
            waist: 'garment_dim_waist',
            hip: 'garment_dim_hip',
            length: 'garment_dim_length',
            inseam: 'garment_dim_inseam',
          };
          dyn.innerHTML = garmentDims
            .map((d) => {
              const key = dimLabel[d];
              if (!key) return '';
              const label = esc(t(key, d));
              return (
                '<div class="sa-input-col">' +
                  '<label class="sa-label" for="sa-ref-' + d + '">' + label + '</label>' +
                  '<input type="number" id="sa-ref-' + d + '" inputmode="decimal" autocomplete="off" placeholder="cm">' +
                '</div>'
              );
            })
            .join('');
        }
        if (gt && gf) {
          gt.addEventListener('click', () => {
            const open = gf.hidden;
            gf.hidden = !open;
            gt.setAttribute('aria-expanded', String(open));
          });
        }
      }
      // Admin może wymusić język widżetu (Ustawienia); "auto" = jak sklep.
      let needI18n = false;
      const forced = String(statusData.widgetLang || 'auto').toLowerCase();
      if ((forced === 'pl' || forced === 'en') && forced !== saLang) {
        saLang = forced;
        needI18n = true;
      }

      // Kupujący może przełączyć język ikoną 🌐 (plan Growth+).
      if (statusData.langSwitch === true) {
        try {
          const stored = localStorage.getItem('sa-lang');
          if ((stored === 'pl' || stored === 'en') && stored !== saLang) {
            saLang = stored;
            needI18n = true;
          }
        } catch (e) {}
        const lt = (saRoot || document).querySelector('#sa-lang-toggle');
        const setToggleLabel = () => {
          const codeEl = lt && lt.querySelector('.sa-lang-code');
          // Pokazujemy AKTUALNY język widżetu (nie docelowy).
          if (codeEl) codeEl.textContent = saLang === 'pl' ? 'PL' : 'ENG';
        };
        if (lt) {
          lt.hidden = false;
          setToggleLabel();
          lt.addEventListener('click', () => {
            applyI18n(saLang === 'pl' ? 'en' : 'pl');
            setToggleLabel();
          });
        }
      }

      // Wyrównujemy etykiety tylko gdy język różni się od tego, co wyrenderował
      // serwer (Liquid `| t`), żeby nie nadpisywać ewentualnych zmian w locale.
      if (needI18n) applyI18n(saLang);

      if (statusData.poweredBy !== false) {
        const pb = document.getElementById('sa-powered-by');
        if (pb) pb.hidden = false;
      }

      if (statusData.customCss) {
        const st = document.createElement('style');
        st.setAttribute('data-sa-custom', '');
        st.textContent = String(statusData.customCss);
        document.head.appendChild(st);
      }

      container.hidden = false;
    } catch (err) {
      console.error('Size Advisor: status check failed.', err);
      return;
    }

    const btn = document.getElementById('size-advisor-btn');
    const modal = document.getElementById('size-advisor-modal');
    const modalContent = modal ? modal.querySelector('.size-advisor-modal-content') : null;
    const close = document.getElementById('size-advisor-close');
    const calcBtn = document.getElementById('get-recommendation-btn');
    const resultDiv = document.getElementById('size-advisor-result');
    const cartAction = document.getElementById('sa-cart-action');
    const nextBtn = document.getElementById('sa-next-btn');
    const backBtn = document.getElementById('sa-back-btn');
    const step1El = document.getElementById('sa-step-1');
    const step2El = document.getElementById('sa-step-2');
    const stepDots = modal ? modal.querySelectorAll('.sa-step-dots span') : [];
    let lastFocus = null;

    // Formularz podzielony na 2 kroki (wzrost/waga vs budowa/dopasowanie) —
    // krótszy widoczny ekran naraz, zwłaszcza na telefonie. Wartości pól nie
    // znikają przy przełączaniu (to po prostu show/hide tych samych węzłów).
    function goToStep(n) {
      if (step1El) step1El.hidden = n !== 1;
      if (step2El) step2El.hidden = n !== 2;
      stepDots.forEach((d, i) => d.classList.toggle('is-active', i === n - 1));
      if (resultDiv && !resultDiv.classList.contains('sa-result--ok')) {
        resultDiv.hidden = true;
      }
    }

    function validateStep1() {
      const rawHeight = Number(document.getElementById('user-height').value);
      const rawWeight = Number(document.getElementById('user-weight').value);
      const height = Math.round(hUnit === 'in' ? rawHeight * IN_PER_CM : rawHeight);
      const weight = Math.round(wUnit === 'lb' ? rawWeight * LB_PER_KG : rawWeight);
      if (!height || height < 140 || height > 215) {
        setResult('err', String(I18N.err_height).replace('[range]', rangeLabel('height')));
        return false;
      }
      if (!weight || weight < 40 || weight > 180) {
        setResult('err', String(I18N.err_weight).replace('[range]', rangeLabel('weight')));
        return false;
      }
      return true;
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (!validateStep1()) return;
        goToStep(2);
      });
    }
    if (backBtn) {
      backBtn.addEventListener('click', () => goToStep(1));
    }

    function openModal() {
      if (!modal) return;
      lastFocus = document.activeElement;
      modal.classList.add('is-open');
      document.body.classList.add('sa-scroll-lock');
      setTimeout(() => { if (modalContent) modalContent.focus(); }, 40);
    }
    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      document.body.classList.remove('sa-scroll-lock');
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
    }

    function setResult(state, html) {
      resultDiv.hidden = false;
      resultDiv.className = 'sa-result' + (state ? ' sa-result--' + state : '');
      resultDiv.innerHTML = html;
    }

    // Wspólny render wyniku „OK" — używa go i przycisk „Oblicz", i pasek
    // „Mój rozmiar" (gdy wynik jest w cache). `data.logId` bywa puste (cache).
    function showResult(data) {
      let html =
        '<span class="sa-result-size">' +
        esc(withSize(I18N.result_size, data.size)) + '</span>';
      html += fitScaleHtml(data);
      setResult('ok', html);
      if (allowAddToCart) renderCartAction(data.size, data.logId);
    }

    // Skala dopasowania = progress bar. `data.fitScale` z /recommend niesie
    // gotowe { labels, pos, recIndex } — silnik interpoluje `pos` płynnie, więc
    // pinezka „Ty" jedzie po całym torze i nie przeskakuje przy zmianie rozmiaru.
    // Fallback (stare odpowiedzi / brak fitScale): sklej z sąsiadów, pinezka na
    // środku komórki rekomendowanego rozmiaru.
    function fitScaleHtml(data) {
      let labels;
      let pos;
      let recIndex;
      const fs = data && data.fitScale;
      if (fs && Array.isArray(fs.labels) && fs.labels.length >= 2) {
        labels = fs.labels.slice(0, 4).map(String);
        recIndex = Math.max(0, Math.min(labels.length - 1, fs.recIndex | 0));
        pos = Number(fs.pos);
        if (!Number.isFinite(pos)) pos = (recIndex + 0.5) / labels.length;
      } else {
        const sm = data && data.neighborSmaller;
        const lg = data && data.neighborLarger;
        const mid = data && data.size;
        if (!sm && !lg) return '';
        labels = [];
        if (sm) labels.push(String(sm));
        labels.push(String(mid));
        if (lg) labels.push(String(lg));
        recIndex = sm ? 1 : 0;
        pos = (recIndex + 0.5) / labels.length;
      }
      pos = Math.max(0.04, Math.min(0.96, pos));
      const n = labels.length;
      const pct = (pos * 100).toFixed(1);
      let ticks = '';
      for (let i = 1; i < n; i++) {
        ticks +=
          '<span class="sa-fit-tick" style="left:' +
          ((i / n) * 100).toFixed(1) + '%"></span>';
      }
      const cells = labels
        .map((s, i) =>
          '<span class="sa-fit-cell' + (i === recIndex ? ' sa-fit-cell--rec' : '') +
          '">' + esc(s) + '</span>')
        .join('');
      return (
        '<div class="sa-fit-scale">' +
          '<div class="sa-fit-ends">' +
            '<span>&larr; ' + esc(t('fit_tighter', 'Ciaśniej')) + '</span>' +
            '<span>' + esc(t('fit_looser', 'Luźniej')) + ' &rarr;</span>' +
          '</div>' +
          '<div class="sa-fit-tw">' +
            '<span class="sa-fit-pin" style="left:' + pct + '%">' +
              '<span class="sa-fit-pin-tag">' + esc(t('fit_you', 'Ty')) + '</span>' +
            '</span>' +
            '<div class="sa-fit-track">' + ticks +
              '<span class="sa-fit-fill" style="width:' + pct + '%"></span>' +
            '</div>' +
          '</div>' +
          '<div class="sa-fit-cells">' + cells + '</div>' +
        '</div>'
      );
    }

    function findVariantForSize(size) {
      if (!Array.isArray(saVariants) || !size) return null;
      const target = String(size).trim().toLowerCase();
      const matches = saVariants.filter((v) =>
        [v.option1, v.option2, v.option3].some(
          (opt) => opt && String(opt).trim().toLowerCase() === target
        )
      );
      if (!matches.length) return null;
      return matches.find((v) => v.available) || matches[0];
    }

    async function pingAccepted(logId) {
      if (!logId) return;
      try {
        await fetch('/apps/size-advisor/accept', {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain' },
          body: JSON.stringify({ logId }),
        });
      } catch (err) {
        console.error('Size Advisor: failed to record add-to-cart event.', err);
      }
    }

    function renderCartAction(size, logId) {
      cartAction.innerHTML = '';
      const variant = findVariantForSize(size);

      // Brak wariantu w tym rozmiarze w ogóle → poproś o ręczny wybór.
      if (!variant) {
        cartAction.hidden = false;
        const note = document.createElement('p');
        note.className = 'sa-cart-note';
        note.innerText = withSize(I18N.pick_above, size);
        cartAction.appendChild(note);
        return;
      }

      // Wariant istnieje, ale wyprzedany → komunikat zamiast martwego przycisku.
      if (variant.available === false) {
        cartAction.hidden = false;
        const note = document.createElement('p');
        note.className = 'sa-cart-note';
        note.innerText = withSize(I18N.out_of_stock, size);
        cartAction.appendChild(note);
        return;
      }

      cartAction.hidden = false;

      const addBtn = document.createElement('button');
      addBtn.type = 'button';
      addBtn.className = 'sa-add-to-cart';
      addBtn.innerText = '🛒 ' + withSize(I18N.add_to_cart, size);

      addBtn.addEventListener('click', async () => {
        addBtn.disabled = true;
        addBtn.innerText = I18N.adding;
        try {
          const addBody = { id: variant.id, quantity: 1 };
          if (logId) {
            // Hidden line-item property (leading "_") — not shown to the customer
            // in cart/checkout but present on the order; the orders/create webhook
            // uses it to recognise a purchase driven by a recommendation.
            addBody.properties = { _size_advisor: logId };
          }

          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(addBody),
          });
          if (!res.ok) throw new Error('cart/add failed: ' + res.status);

          await pingAccepted(logId);

          cartAction.innerHTML =
            '<p class="sa-cart-done">✓ ' + withSize(I18N.added, size) +
            '<br><a href="/cart">' + I18N.go_to_cart + '</a></p>';
        } catch (err) {
          console.error('Size Advisor: add-to-cart failed.', err);
          addBtn.disabled = false;
          addBtn.innerText = '🛒 ' + withSize(I18N.add_to_cart, size);
          const note = document.createElement('p');
          note.className = 'sa-cart-note';
          note.innerText = I18N.add_failed;
          cartAction.appendChild(note);
        }
      });

      cartAction.appendChild(addBtn);
    }

    if (btn && modal) {
      btn.addEventListener('click', openModal);
      close.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
      });
    }

    function setupPillGroup(groupId) {
      const group = document.getElementById(groupId);
      if (!group) return;
      const buttons = group.querySelectorAll('.sa-pill-btn');
      buttons.forEach(b => {
        b.addEventListener('click', () => {
          buttons.forEach(btnEl => {
            btnEl.classList.remove('active');
            btnEl.setAttribute('aria-pressed', 'false');
          });
          b.classList.add('active');
          b.setAttribute('aria-pressed', 'true');
        });
      });
    }

    setupPillGroup('sa-gender-group');
    setupPillGroup('sa-body-group');
    setupPillGroup('sa-fit-group');

    // --- Jednostki: CM/IN + kg/lb. Kontrakt serwera zostaje metryczny —
    // konwertujemy tuż przed wysłaniem. Wybór trzymamy w localStorage
    // niezależnie dla wzrostu i wagi (np. "cm/lb").
    const IN_PER_CM = 2.54;
    const LB_PER_KG = 0.45359237;
    let hUnit = 'cm';
    let wUnit = 'kg';
    try {
      const saved = String(localStorage.getItem('sa-units') || '').split('/');
      if (saved[0] === 'cm' || saved[0] === 'in') hUnit = saved[0];
      if (saved[1] === 'kg' || saved[1] === 'lb') wUnit = saved[1];
    } catch (e) {}

    function setUnitToggle(groupId, unit) {
      const g = document.getElementById(groupId);
      if (!g) return;
      g.querySelectorAll('button').forEach((b) => {
        const on = b.dataset.unit === unit;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }

    applyUnits = function () {
      const hIn = hUnit === 'in';
      const wLb = wUnit === 'lb';
      const scope = saRoot || document;
      const hLabel = scope.querySelector('label[for="user-height"]');
      const wLabel = scope.querySelector('label[for="user-weight"]');
      const hEl = document.getElementById('user-height');
      const wEl = document.getElementById('user-weight');
      if (hLabel) hLabel.textContent = t('height', 'Wzrost') + ' (' + hUnit + ')';
      if (wLabel) wLabel.textContent = t('weight', 'Waga') + ' (' + wUnit + ')';
      if (hEl) {
        hEl.min = hIn ? 55 : 140;
        hEl.max = hIn ? 85 : 215;
        hEl.placeholder = hIn ? t('height_ph_in', 'np. 72') : t('height_ph', 'np. 182');
      }
      if (wEl) {
        wEl.min = wLb ? 88 : 40;
        wEl.max = wLb ? 397 : 180;
        wEl.placeholder = wLb ? t('weight_ph_lb', 'np. 165') : t('weight_ph', 'np. 78');
      }
      setUnitToggle('sa-height-unit', hUnit);
      setUnitToggle('sa-weight-unit', wUnit);
    };

    function wireUnitToggle(groupId, which) {
      const g = document.getElementById(groupId);
      if (!g) return;
      g.querySelectorAll('button').forEach((b) => {
        b.addEventListener('click', () => {
          const u = b.dataset.unit;
          if (which === 'h') hUnit = u; else wUnit = u;
          try { localStorage.setItem('sa-units', hUnit + '/' + wUnit); } catch (e) {}
          applyUnits();
        });
      });
    }
    wireUnitToggle('sa-height-unit', 'h');
    wireUnitToggle('sa-weight-unit', 'w');
    applyUnits();

    const rangeLabel = (metric) =>
      metric === 'height'
        ? (hUnit === 'in' ? '55–85 in' : '140–215 cm')
        : (wUnit === 'lb' ? '88–397 lb' : '40–180 kg');

    // Wymiary ubrania referencyjnego z dynamicznych pól (patrz garmentDims) —
    // ta sama jednostka co wzrost (hUnit), bo to też pomiar na płasko w cm/in.
    function collectRefMeasurements() {
      if (!askGarment) return {};
      const out = {};
      garmentDims.forEach((d) => {
        const el = document.getElementById('sa-ref-' + d);
        const raw = el ? Number(el.value) : NaN;
        if (Number.isFinite(raw) && raw > 0) {
          out[d] = Math.round(hUnit === 'in' ? raw * IN_PER_CM : raw);
        }
      });
      return out;
    }

    if (calcBtn) {
      calcBtn.addEventListener('click', async () => {
        if (calcBtn.dataset.loading === '1') return;

        // Normalnie już zweryfikowane przez "Dalej" (krok 1) — sprawdzamy
        // ponownie na wszelki wypadek (np. ktoś zmienił pole po powrocie).
        if (!validateStep1()) return;

        const rawHeight = Number(document.getElementById('user-height').value);
        const rawWeight = Number(document.getElementById('user-weight').value);
        // Serwer i silnik oczekują cm/kg — konwersja i zaokrąglenie tutaj.
        const height = Math.round(hUnit === 'in' ? rawHeight * IN_PER_CM : rawHeight);
        const weight = Math.round(wUnit === 'lb' ? rawWeight * LB_PER_KG : rawWeight);
        const gender = document.querySelector('#sa-gender-group .sa-pill-btn.active')?.dataset.value || 'male';
        const bodyType = document.querySelector('#sa-body-group .sa-pill-btn.active')?.dataset.value || 'standard';

        const _fp = askFitPref
          ? (document.querySelector('#sa-fit-group .sa-pill-btn.active')?.dataset.value || 'regular')
          : '';
        const refM = collectRefMeasurements();
        const calcKey = [height, weight, gender, bodyType, _fp, JSON.stringify(refM), saLang].join('|');
        const resultShown = resultDiv && !resultDiv.hidden && resultDiv.classList.contains('sa-result--ok');
        if (calcKey === lastCalcKey && resultShown) {
          // te same dane + wynik już widoczny → nic nie ruszamy (przycisk koszyka zostaje)
          return;
        }

        cartAction.hidden = true;
        cartAction.innerHTML = '';

        calcBtn.dataset.loading = '1';
        calcBtn.disabled = true;
        calcBtn.classList.add('is-loading');
        setResult('loading', '<span>' + I18N.calc_loading + '</span>');

        const fitPreference = _fp;

        try {
          const payload = JSON.stringify({
            height,
            weight,
            gender,
            bodyType,
            fitPreference,
            refMeasurements: refM,
            locale: saLang || window.__SA_LOCALE || 'en',
            productId: {{ product.id | json }},
            productTitle: {{ product.title | default: "" | json }},
            productDescription: {{ product.description | strip_html | json }}
          });

          const response = await fetch('/apps/size-advisor/recommend', {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain' },
            body: payload
          });

          const data = await response.json();

          if (data.error) {
            setResult('err', esc(data.error));
          } else {
            // Kupujący widzi tylko rozmiar + suwak dopasowania — bez zdań
            // opisowych, centymetrów i zastrzeżeń (szczegół zostaje w testerze).
            showResult(data);
            lastCalcKey = calcKey; // zapamiętaj — powtórka z tymi samymi danymi nie wyśle zapytania
            // Zapamiętaj profil + wynik: kolejne produkty pokażą „Mój rozmiar".
            // Pasek tylko dla produktów z prawdziwą rozmiarówką (source=chart).
            if (!Object.keys(refM).length) {
              const prof = { g: gender, h: height, w: weight, bt: bodyType, fp: fitPreference || '' };
              saveProfile(prof);
              saveSize(prof, data);
              if (data.source === 'chart') {
                try { sessionStorage.removeItem('sa-mysize-x'); } catch (e) {}
                renderMySize(data.size);
              }
            }
          }
        } catch (err) {
          setResult('err', I18N.err_connection);
        } finally {
          calcBtn.dataset.loading = '0';
          calcBtn.disabled = false;
          calcBtn.classList.remove('is-loading');
        }
      });
    }

    // ================= „Mój rozmiar: X" =================================
    // Profil (wymiary) i wynik per produkt trzymamy w localStorage. Gdy profil
    // istnieje: pokazujemy pasek zamiast przycisku. Wynik z cache = zero zapytań;
    // brak cache + plan z `autoSize` = jedno ciche przeliczenie dla tego produktu.
    const SA_PID = String({{ product.id | json }} == null ? '' : {{ product.id | json }}).replace(/\D/g, '');
    const PROFILE_KEY = 'sa-profile';
    const SIZES_KEY = 'sa-sizes-v2'; // v2: wpisy niosą source ('chart'/'na')
    const SIZE_TTL = 1000 * 60 * 60 * 24 * 30;

    function readJSON(key) {
      try { return JSON.parse(localStorage.getItem(key) || 'null'); } catch (e) { return null; }
    }
    function writeJSON(key, val) {
      try { localStorage.setItem(key, JSON.stringify(val)); } catch (e) {}
    }
    function profileHash(p) {
      return [p.g, p.h, p.w, p.bt, p.fp || '', saLang].join('|');
    }
    function getProfile() {
      const p = readJSON(PROFILE_KEY);
      if (!p || !(Number(p.h) > 0) || !(Number(p.w) > 0)) return null;
      return p;
    }
    function saveProfile(p) {
      writeJSON(PROFILE_KEY, { g: p.g, h: p.h, w: p.w, bt: p.bt, fp: p.fp || '', ver: 1 });
    }
    function cachedSize(p) {
      if (!SA_PID) return null;
      const all = readJSON(SIZES_KEY) || {};
      const hit = all[SA_PID];
      if (!hit || hit.ph !== profileHash(p) || Date.now() - (hit.ts || 0) > SIZE_TTL) return null;
      return hit; // { na: true } = produkt bez rozmiarówki → paska nie pokazujemy
    }
    function putSize(p, entry) {
      if (!SA_PID) return;
      const all = readJSON(SIZES_KEY) || {};
      all[SA_PID] = Object.assign({ ph: profileHash(p), ts: Date.now() }, entry);
      const keys = Object.keys(all);
      if (keys.length > 60) delete all[keys[0]];
      writeJSON(SIZES_KEY, all);
    }
    // Zapisujemy „prawdziwy" wynik tylko gdy policzony z tabeli/analizy produktu.
    // Sam szacunek z sylwetki (brak rozmiarówki / produkt nieodzieżowy, np. wosk
    // do nart) → wpis „na", żeby pasek się nie pokazywał i nie wołać co wejście.
    function saveSize(p, data) {
      if (!data || !data.size) return;
      if (data.source === 'chart') {
        putSize(p, {
          size: data.size,
          neighborSmaller: data.neighborSmaller || null,
          neighborLarger: data.neighborLarger || null,
          fitScale: data.fitScale || null,
        });
      } else {
        putSize(p, { na: true });
      }
    }

    function setPill(groupId, value) {
      const g = document.getElementById(groupId);
      if (!g || !value) return;
      g.querySelectorAll('.sa-pill-btn').forEach((b) => {
        const on = b.dataset.value === value;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }
    function applyProfile(p) {
      setPill('sa-gender-group', p.g);
      setPill('sa-body-group', p.bt);
      if (askFitPref && p.fp) setPill('sa-fit-group', p.fp);
      const hEl = document.getElementById('user-height');
      const wEl = document.getElementById('user-weight');
      if (hEl) hEl.value = hUnit === 'in' ? Math.round(Number(p.h) / IN_PER_CM) : p.h;
      if (wEl) wEl.value = wUnit === 'lb' ? Math.round(Number(p.w) / LB_PER_KG) : p.w;
    }

    const myPill = document.getElementById('sa-mysize');
    function renderMySize(size) {
      if (!myPill || !size) return;
      const val = myPill.querySelector('.sa-mysize-val');
      if (val) val.textContent = size;
      myPill.hidden = false;
      if (btn) btn.hidden = true;
      container.hidden = false;
    }

    function restoreTrigger() {
      if (myPill) myPill.hidden = true;
      if (btn) btn.hidden = false;
    }

    async function autoRecommend(p) {
      try {
        const payload = JSON.stringify({
          height: Number(p.h),
          weight: Number(p.w),
          gender: p.g,
          bodyType: p.bt,
          fitPreference: askFitPref ? (p.fp || 'regular') : '',
          refMeasurements: {},
          locale: saLang || window.__SA_LOCALE || 'en',
          productId: {{ product.id | json }},
          productTitle: {{ product.title | default: "" | json }},
          productDescription: {{ product.description | strip_html | json }}
        });
        const res = await fetch('/apps/size-advisor/recommend', {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain' },
          body: payload,
        });
        const data = await res.json();
        if (data && data.size && !data.error && data.source === 'chart') {
          saveSize(p, data);
          renderMySize(data.size);
        } else {
          if (data && !data.error) saveSize(p, data); // zapamiętaj „na"
          restoreTrigger();
        }
      } catch (e) {
        restoreTrigger(); // cicho — zostaje zwykły przycisk
      }
    }

    (function initMySize() {
      if (!myPill) return;
      const profile = getProfile();
      let dismissed = false;
      try { dismissed = sessionStorage.getItem('sa-mysize-x') === '1'; } catch (e) {}

      if (profile) {
        applyProfile(profile);
        if (!dismissed && SA_PID) {
          const hit = cachedSize(profile);
          if (hit && !hit.na) {
            renderMySize(hit.size);
          } else if (!hit && autoSize) {
            renderMySize('…'); // od razu chowamy przycisk, wypełnimy po odpowiedzi
            autoRecommend(profile);
          }
        }
      }

      const openIt = () => {
        const p = getProfile();
        const hit = p && cachedSize(p);
        if (hit && !hit.na && hit.size) {
          applyProfile(p);
          // Wynik jest już gotowy (z cache) — pokaż od razu krok 2 (tam jest
          // przycisk "Oblicz ponownie" i sam wynik), nie każ przechodzić przez
          // krok 1 na nowo dla danych, które już mamy.
          goToStep(2);
          showResult({
            size: hit.size,
            neighborSmaller: hit.neighborSmaller,
            neighborLarger: hit.neighborLarger,
            fitScale: hit.fitScale,
          });
        }
        openModal();
      };
      const moreBtn = document.getElementById('sa-mysize-more');
      const xBtn = document.getElementById('sa-mysize-x');
      myPill.addEventListener('click', (e) => {
        if (e.target === xBtn || e.target === moreBtn) return;
        openIt();
      });
      if (moreBtn) moreBtn.addEventListener('click', openIt);
      if (xBtn) xBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        myPill.hidden = true;
        if (btn) btn.hidden = false;
        try { sessionStorage.setItem('sa-mysize-x', '1'); } catch (er) {}
      });
    })();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSizeAdvisor);
  } else {
    initSizeAdvisor();
  }
</script>

