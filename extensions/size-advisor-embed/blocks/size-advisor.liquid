{%- liquid
  assign sa_accent = block.settings.accent | default: '#1a1a1a'
  assign sa_bg = block.settings.bg_color | default: '#1a1a1a'
  assign sa_fg = block.settings.text_color | default: '#ffffff'
  assign sa_bg_h = block.settings.bg_color_hover
  assign sa_label = block.settings.trigger_label
  assign sa_width = block.settings.button_width | default: 'inline'
  assign sa_hover = block.settings.hover_effect | default: 'fade'
  assign sa_align = block.settings.button_align | default: 'flex-start'
  assign sa_custom_w = block.settings.custom_width | default: 0
  assign sa_modal_title = block.settings.modal_title
  assign sa_modal_subtitle = block.settings.modal_subtitle
-%}

<div
  class="sa-root sa-w-{{ sa_width }} sa-hover-{{ sa_hover }}{% if sa_custom_w > 0 %} sa-fixed-w{% endif %}"
  id="sa-root-{{ block.id }}"
  style="
    --sa-accent: {{ sa_accent }};
    --sa-btn-bg: {{ sa_bg }};
    --sa-btn-fg: {{ sa_fg }};
    {% if sa_bg_h != blank %}--sa-btn-bg-h: {{ sa_bg_h }};{% endif %}
    --sa-btn-fs: {{ block.settings.font_size | default: 15 }}px;
    --sa-btn-fw: {{ block.settings.font_weight | default: '600' }};
    --sa-btn-py: {{ block.settings.padding_y | default: 13 }}px;
    --sa-btn-px: {{ block.settings.padding_x | default: 22 }}px;
    --sa-btn-radius: {{ block.settings.corner_radius | default: 8 }}px;
    --sa-btn-bw: {{ block.settings.border_width | default: 0 }}px;
    --sa-btn-bc: {{ block.settings.border_color | default: '#1a1a1a' }};
    --sa-btn-space: {{ block.settings.spacing | default: 15 }}px;
    --sa-btn-justify: {{ sa_align }};
    --sa-btn-w: {{ sa_custom_w }}px;
  "
>
  <div class="size-advisor-container" id="size-advisor-container" hidden>
    <button type="button" id="size-advisor-btn" class="size-advisor-trigger">
      {% if block.settings.show_icon != false %}
        <span class="sa-trigger-icon" aria-hidden="true">{{ block.settings.icon_char | default: '📏' }}</span>
      {% endif %}
      <span>{% if sa_label != blank %}{{ sa_label }}{% else %}{{ 'size_advisor.trigger' | t }}{% endif %}</span>
    </button>
    <div class="sa-mysize" id="sa-mysize" hidden>
      <span class="sa-mysize-badge" aria-hidden="true">{{ block.settings.icon_char | default: '📏' }}</span>
      <span class="sa-mysize-text"><span data-i18n="mysize">{{ 'size_advisor.mysize' | t }}</span>: <b class="sa-mysize-val"></b></span>
      <button type="button" class="sa-mysize-more" id="sa-mysize-more" data-i18n="mysize_more">{{ 'size_advisor.mysize_more' | t }}</button>
      <button type="button" class="sa-mysize-x" id="sa-mysize-x" data-i18n-aria="close" aria-label="{{ 'size_advisor.close' | t }}">&times;</button>
    </div>
  </div>

  <div
    id="size-advisor-modal"
    class="size-advisor-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sa-modal-title-{{ block.id }}"
  >
    <div class="size-advisor-modal-content" tabindex="-1">
      <button type="button" id="size-advisor-close" class="size-advisor-close" data-i18n-aria="close" aria-label="{{ 'size_advisor.close' | t }}">&times;</button>
      <button type="button" id="sa-lang-toggle" class="sa-lang-toggle" hidden>
        <span aria-hidden="true">🌐</span><span class="sa-lang-code">ENG</span>
      </button>
      <h3 class="size-advisor-title" id="sa-modal-title-{{ block.id }}"{% if sa_modal_title == blank %} data-i18n="modal_title"{% endif %}>{% if sa_modal_title != blank %}{{ sa_modal_title }}{% else %}{{ 'size_advisor.modal_title' | t }}{% endif %}</h3>
      <p class="size-advisor-desc"{% if sa_modal_subtitle == blank %} data-i18n="modal_desc"{% endif %}>{% if sa_modal_subtitle != blank %}{{ sa_modal_subtitle }}{% else %}{{ 'size_advisor.modal_desc' | t }}{% endif %}</p>

      <div class="size-advisor-form">
        <div class="sa-step-dots" aria-hidden="true">
          <span class="sa-step-dot is-active"></span>
          <span class="sa-step-dot"></span>
        </div>

        <div class="sa-step" id="sa-step-1" data-sa-step="1">
          <span class="sa-label" id="sa-gender-label-{{ block.id }}" data-i18n="gender">{{ 'size_advisor.gender' | t }}</span>
          <div class="sa-pill-group sa-pill-group--2" id="sa-gender-group" role="group" aria-labelledby="sa-gender-label-{{ block.id }}">
            <button type="button" class="sa-pill-btn active" data-value="male" aria-pressed="true" data-i18n="gender_male">{{ 'size_advisor.gender_male' | t }}</button>
            <button type="button" class="sa-pill-btn" data-value="female" aria-pressed="false" data-i18n="gender_female">{{ 'size_advisor.gender_female' | t }}</button>
          </div>

          <div class="sa-grid-inputs">
            <div class="sa-input-col">
              <div class="sa-field-head">
                <label class="sa-label" for="user-height" data-i18n="height">{{ 'size_advisor.height' | t }}</label>
                <div class="sa-unit-toggle" id="sa-height-unit" role="group" aria-label="cm / in">
                  <button type="button" data-unit="cm" aria-pressed="true">cm</button>
                  <button type="button" data-unit="in" aria-pressed="false">in</button>
                </div>
              </div>
              <input type="number" id="user-height" inputmode="decimal" data-i18n-ph="height_ph" placeholder="{{ 'size_advisor.height_ph' | t }}" min="140" max="215">
            </div>
            <div class="sa-input-col">
              <div class="sa-field-head">
                <label class="sa-label" for="user-weight" data-i18n="weight">{{ 'size_advisor.weight' | t }}</label>
                <div class="sa-unit-toggle" id="sa-weight-unit" role="group" aria-label="kg / lb">
                  <button type="button" data-unit="kg" aria-pressed="true">kg</button>
                  <button type="button" data-unit="lb" aria-pressed="false">lb</button>
                </div>
              </div>
              <input type="number" id="user-weight" inputmode="decimal" data-i18n-ph="weight_ph" placeholder="{{ 'size_advisor.weight_ph' | t }}" min="40" max="180">
            </div>
          </div>

          <button type="button" id="sa-next-btn">
            <span class="sa-btn-label" data-i18n="next">{{ 'size_advisor.next' | t }}</span>
          </button>
        </div>

        <div class="sa-step" id="sa-step-2" data-sa-step="2" hidden>
          <span class="sa-label" id="sa-body-label-{{ block.id }}" data-i18n="body">{{ 'size_advisor.body' | t }}</span>
          <div class="sa-pill-group sa-pill-group--2" id="sa-body-group" role="group" aria-labelledby="sa-body-label-{{ block.id }}">
            <button type="button" class="sa-pill-btn" data-value="slim" aria-pressed="false" data-i18n="body_slim">{{ 'size_advisor.body_slim' | t }}</button>
            <button type="button" class="sa-pill-btn active" data-value="standard" aria-pressed="true" data-i18n="body_standard">{{ 'size_advisor.body_standard' | t }}</button>
            <button type="button" class="sa-pill-btn" data-value="athletic" aria-pressed="false" data-i18n="body_athletic">{{ 'size_advisor.body_athletic' | t }}</button>
            <button type="button" class="sa-pill-btn" data-value="plus" aria-pressed="false" data-i18n="body_plus">{{ 'size_advisor.body_plus' | t }}</button>
          </div>

          <div id="sa-fit-wrap" hidden>
            <span class="sa-label" id="sa-fit-label-{{ block.id }}" data-i18n="fit">{{ 'size_advisor.fit' | t }}</span>
            <div class="sa-pill-group sa-pill-group--3" id="sa-fit-group" role="group" aria-labelledby="sa-fit-label-{{ block.id }}">
              <button type="button" class="sa-pill-btn" data-value="fitted" aria-pressed="false" data-i18n="fit_fitted">{{ 'size_advisor.fit_fitted' | t }}</button>
              <button type="button" class="sa-pill-btn active" data-value="regular" aria-pressed="true" data-i18n="fit_regular">{{ 'size_advisor.fit_regular' | t }}</button>
              <button type="button" class="sa-pill-btn" data-value="loose" aria-pressed="false" data-i18n="fit_loose">{{ 'size_advisor.fit_loose' | t }}</button>
            </div>
          </div>

          <div id="sa-garment-wrap" hidden>
            <button type="button" id="sa-garment-toggle" class="sa-garment-toggle" aria-expanded="false" aria-controls="sa-garment-fields" data-i18n="garment_toggle">
              {{ 'size_advisor.garment_toggle' | t }}
            </button>
            <div id="sa-garment-fields" class="sa-garment-fields" hidden>
              <div class="sa-grid-inputs" id="sa-garment-dyn"></div>
              <p class="sa-garment-hint" data-i18n="garment_hint">{{ 'size_advisor.garment_hint' | t }}</p>
            </div>
          </div>

          <button type="button" class="sa-step-back" id="sa-back-btn" data-i18n="back">{{ 'size_advisor.back' | t }}</button>

          <button type="button" id="get-recommendation-btn">
            <span class="sa-btn-label" data-i18n="calc">{{ 'size_advisor.calc' | t }}</span>
          </button>
        </div>
      </div>

      <div id="size-advisor-result" class="sa-result" role="status" aria-live="polite" hidden></div>
      <div id="sa-cart-action" class="sa-cart-action" hidden></div>
      <p id="sa-powered-by" class="sa-powered-by" hidden>Size Advisor</p>
    </div>
  </div>
</div>

<style>
  {%- if block.settings.button_font -%}
    {{ block.settings.button_font | font_face: font_display: 'swap' }}
    #sa-root-{{ block.id }} {
      --sa-btn-ff: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    }
  {%- endif -%}
  .sa-root {
    /* Wspólne zaokrąglenie — pola/pigułki/wynik idą za ustawieniem przycisku,
       ale przycięte do 16px, żeby inputy nie robiły się przesadnie okrągłe. */
    --sa-radius: clamp(4px, var(--sa-btn-radius, 8px), 16px);
    --sa-border: #e3e5ea;
    --sa-border-strong: #d3d6dd;
    --sa-muted: #6b7280;
    --sa-ink: #14161c;
    --sa-bg-soft: #f5f6f8;
    --sa-bg-tint: #fafbfc;
    --sa-shadow: 0 24px 70px -12px rgba(16, 18, 26, 0.4), 0 6px 20px -8px rgba(16, 18, 26, 0.22);
    --sa-focus: color-mix(in srgb, var(--sa-accent) 22%, transparent);
  }
  .sa-root * { box-sizing: border-box; }
  /* Niektóre elementy mają własne `display:` (flex/inline-flex), co bije atrybut
     [hidden] z UA-stylesheet. Bez tego: wyłączenie apki nie chowa przycisku,
     przełącznik języka pokazuje się mimo braku uprawnień itd. */
  .sa-root [hidden] { display: none !important; }

  .size-advisor-container {
    margin: var(--sa-btn-space, 15px) 0;
    display: flex;
    justify-content: var(--sa-btn-justify, flex-start);
  }
  .sa-root:not(.sa-fixed-w).sa-w-full .size-advisor-trigger { width: 100%; }
  .sa-root:not(.sa-fixed-w).sa-w-inline .size-advisor-trigger { width: auto; }
  .sa-fixed-w .size-advisor-trigger { width: var(--sa-btn-w); }

  .size-advisor-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    max-width: 100%;
    background-color: var(--sa-btn-bg, #1a1a1a);
    color: var(--sa-btn-fg, #fff);
    padding: var(--sa-btn-py, 13px) var(--sa-btn-px, 22px);
    border: var(--sa-btn-bw, 0px) solid var(--sa-btn-bc, #1a1a1a);
    cursor: pointer;
    border-radius: var(--sa-btn-radius, 8px);
    font-family: var(--sa-btn-ff, inherit);
    font-weight: var(--sa-btn-fw, 600);
    font-size: var(--sa-btn-fs, 15px);
    line-height: 1.2;
    transition: transform 0.12s ease, box-shadow 0.16s ease, opacity 0.16s ease,
      background-color 0.16s ease, color 0.16s ease;
  }
  .size-advisor-trigger:hover {
    background-color: var(--sa-btn-bg-h, var(--sa-btn-bg, #1a1a1a));
  }
  .sa-hover-fade .size-advisor-trigger:hover { opacity: 0.9; }
  .sa-hover-lift .size-advisor-trigger:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.18);
  }
  .sa-hover-shadow .size-advisor-trigger:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.22); }
  .size-advisor-trigger:active { transform: translateY(1px); }
  .sa-trigger-icon { font-size: 1.05em; }

  /* Pasek „Mój rozmiar: X" — zamiast przycisku, gdy kupujący ma zapisany profil. */
  .sa-mysize {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    max-width: 100%;
    padding: 9px 12px;
    background: #fff;
    border: 1px solid var(--sa-border, #e3e5ea);
    border-radius: var(--sa-btn-radius, 8px);
    font-family: var(--sa-btn-ff, inherit);
    font-size: 13px;
    color: var(--sa-ink, #14161c);
    box-shadow: 0 2px 10px -4px rgba(16, 18, 26, 0.16);
  }
  .sa-root:not(.sa-fixed-w).sa-w-full .sa-mysize { width: 100%; }
  .sa-fixed-w .sa-mysize { width: var(--sa-btn-w); }
  .sa-mysize-badge { font-size: 15px; line-height: 1; flex: none; }
  .sa-mysize-text {
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sa-mysize-val { font-weight: 800; }
  .sa-mysize-more {
    flex: none;
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    color: var(--sa-accent, #1a1a1a);
    text-decoration: underline;
    cursor: pointer;
  }
  .sa-mysize-x {
    flex: none;
    border: 0;
    background: none;
    padding: 0 2px;
    font-size: 18px;
    line-height: 1;
    color: #9aa1ac;
    cursor: pointer;
  }
  .sa-mysize-x:hover { color: var(--sa-ink, #14161c); }

  .size-advisor-modal {
    position: fixed;
    z-index: 2147483000;
    inset: 0;
    background-color: rgba(12, 14, 20, 0.5);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0s linear 0.2s;
  }
  .size-advisor-modal.is-open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.2s ease;
  }

  .size-advisor-modal-content {
    background: #fff;
    color: var(--sa-ink, #14161c);
    padding: 23px 21px 19px;
    border-radius: clamp(12px, calc(var(--sa-btn-radius, 8px) + 8px), 22px);
    max-width: 374px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: var(--sa-shadow);
    font-family: inherit;
    transform: translateY(16px) scale(0.97);
    opacity: 0;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    outline: none;
    -webkit-overflow-scrolling: touch;
  }
  .size-advisor-modal.is-open .size-advisor-modal-content {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .size-advisor-close {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 32px;
    height: 32px;
    font-size: 22px;
    line-height: 1;
    border: none;
    background: var(--sa-bg-soft);
    cursor: pointer;
    color: #9aa0aa;
    border-radius: 50%;
    transition: background 0.14s ease, color 0.14s ease, transform 0.14s ease;
  }
  .size-advisor-close:hover { background: #ececef; color: var(--sa-ink); transform: rotate(90deg); }

  .sa-lang-toggle {
    position: absolute;
    right: 54px;
    top: 15px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 26px;
    padding: 0 8px;
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #6b7280;
    background: transparent;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.14s ease, border-color 0.14s ease;
  }
  .sa-lang-toggle:hover { color: #1f2430; border-color: #d1d5db; }
  .sa-lang-code { line-height: 1; }

  .size-advisor-title {
    margin: 0 40px 5px 0;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .size-advisor-desc { margin: 0 0 14px 0; font-size: 12px; color: var(--sa-muted); line-height: 1.45; }

  .sa-label {
    display: block;
    margin: 13px 0 5px 0;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #7a828f;
  }
  .size-advisor-form > .sa-label:first-child { margin-top: 2px; }

  .sa-pill-group { display: grid; gap: 5px; }
  .sa-pill-group--2 { grid-template-columns: repeat(2, 1fr); }
  .sa-pill-group--3 { grid-template-columns: repeat(3, 1fr); }

  .sa-pill-btn {
    padding: 9px 6px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid var(--sa-border);
    background: var(--sa-bg-tint);
    border-radius: var(--sa-radius);
    cursor: pointer;
    text-align: center;
    color: #3a414d;
    transition: border-color 0.16s ease, background 0.16s ease, color 0.16s ease,
      transform 0.12s ease, box-shadow 0.16s ease;
  }
  .sa-pill-btn:hover {
    border-color: var(--sa-border-strong);
    background: #fff;
    color: var(--sa-ink);
  }
  .sa-pill-btn:active { transform: translateY(1px); }
  .sa-pill-btn.active {
    background: var(--sa-accent);
    color: #fff;
    border-color: var(--sa-accent);
    box-shadow: 0 6px 16px -6px color-mix(in srgb, var(--sa-accent) 55%, transparent);
  }

  .sa-grid-inputs { display: flex; gap: 10px; }
  .sa-input-col { flex: 1; }

  .sa-field-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 11px 0 5px;
  }
  .sa-field-head .sa-label { margin: 0; }
  .sa-unit-toggle {
    display: inline-flex;
    flex: none;
    border: 1px solid var(--sa-border);
    border-radius: 999px;
    overflow: hidden;
  }
  .sa-unit-toggle button {
    border: 0;
    background: #fff;
    color: #6b7280;
    font: inherit;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 8px;
    line-height: 1.4;
    cursor: pointer;
    transition: background 0.14s ease, color 0.14s ease;
  }
  .sa-unit-toggle button + button { border-left: 1px solid var(--sa-border); }
  .sa-unit-toggle button.active { background: var(--sa-accent); color: #fff; }
  .sa-input-col input {
    width: 100%;
    padding: 10px 11px;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--sa-border);
    border-radius: var(--sa-radius);
    background: var(--sa-bg-tint);
    color: var(--sa-ink);
    transition: border-color 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
  }
  .sa-input-col input::placeholder { color: #aab0ba; font-weight: 400; }
  .sa-input-col input:focus {
    outline: none;
    background: #fff;
    border-color: var(--sa-accent);
    box-shadow: 0 0 0 3px var(--sa-focus, rgba(17,19,24,0.08));
  }

  #sa-garment-wrap { margin-top: 11px; }
  .sa-garment-toggle {
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    color: var(--sa-accent);
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .sa-garment-toggle::after {
    content: "›";
    display: inline-block;
    transition: transform 0.15s ease;
    font-size: 15px;
  }
  .sa-garment-toggle[aria-expanded="true"]::after { transform: rotate(90deg); }
  .sa-garment-fields { margin-top: 8px; }
  #sa-garment-dyn { flex-wrap: wrap; }
  #sa-garment-dyn .sa-input-col { flex: 1 1 88px; min-width: 88px; }
  .sa-garment-hint { margin: 6px 0 0; font-size: 12px; color: var(--sa-muted); line-height: 1.4; }

  #get-recommendation-btn,
  #sa-next-btn {
    position: relative;
    width: 100%;
    padding: 12px;
    margin-top: 16px;
    background: var(--sa-accent);
    color: #fff;
    border: none;
    border-radius: var(--sa-radius);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: 0 10px 24px -10px color-mix(in srgb, var(--sa-accent) 60%, transparent);
    transition: transform 0.12s ease, box-shadow 0.18s ease, opacity 0.16s ease;
  }
  #get-recommendation-btn:hover,
  #sa-next-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 30px -10px color-mix(in srgb, var(--sa-accent) 65%, transparent);
  }
  #get-recommendation-btn:active,
  #sa-next-btn:active { transform: translateY(0); }
  #get-recommendation-btn[disabled] { opacity: 0.7; cursor: default; box-shadow: none; transform: none; }

  .sa-step-back {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    padding: 0 0 12px;
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--sa-muted);
    cursor: pointer;
  }
  .sa-step-back:hover { color: var(--sa-accent); }
  .sa-step-back::before { content: "←"; }

  .sa-step-dots {
    display: flex;
