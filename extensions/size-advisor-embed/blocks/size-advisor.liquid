{%- liquid
  assign sa_accent = block.settings.accent | default: '#111111'
  assign sa_bg = block.settings.bg_color | default: '#111111'
  assign sa_fg = block.settings.text_color | default: '#ffffff'
  assign sa_bg_h = block.settings.bg_color_hover
  assign sa_label = block.settings.trigger_label
  assign sa_width = block.settings.button_width | default: 'full'
  assign sa_hover = block.settings.hover_effect | default: 'fade'
  assign sa_align = block.settings.button_align | default: 'flex-start'
  assign sa_custom_w = block.settings.custom_width | default: 0
  assign sa_modal_title = block.settings.modal_title
  assign sa_modal_subtitle = block.settings.modal_subtitle
-%}

<div
  class="sa-root sa-w-{{ sa_width }} sa-hover-{{ sa_hover }}{% if sa_custom_w > 0 %} sa-fixed-w{% endif %}"
  id="sa-root-{{ block.id }}"
  style="
    --sa-accent: {{ sa_accent }};
    --sa-btn-bg: {{ sa_bg }};
    --sa-btn-fg: {{ sa_fg }};
    {% if sa_bg_h != blank %}--sa-btn-bg-h: {{ sa_bg_h }};{% endif %}
    --sa-btn-fs: {{ block.settings.font_size | default: 15 }}px;
    --sa-btn-fw: {{ block.settings.font_weight | default: '600' }};
    --sa-btn-py: {{ block.settings.padding_y | default: 13 }}px;
    --sa-btn-px: {{ block.settings.padding_x | default: 22 }}px;
    --sa-btn-radius: {{ block.settings.corner_radius | default: 8 }}px;
    --sa-btn-bw: {{ block.settings.border_width | default: 0 }}px;
    --sa-btn-bc: {{ block.settings.border_color | default: '#111111' }};
    --sa-btn-space: {{ block.settings.spacing | default: 15 }}px;
    --sa-btn-justify: {{ sa_align }};
    --sa-btn-w: {{ sa_custom_w }}px;
  "
>
  <div class="size-advisor-container" id="size-advisor-container" hidden>
    <button type="button" id="size-advisor-btn" class="size-advisor-trigger">
      {% if block.settings.show_icon != false %}
        <span class="sa-trigger-icon" aria-hidden="true">{{ block.settings.icon_char | default: '📏' }}</span>
      {% endif %}
      <span>{% if sa_label != blank %}{{ sa_label }}{% else %}{{ 'size_advisor.trigger' | t }}{% endif %}</span>
    </button>
  </div>

  <div
    id="size-advisor-modal"
    class="size-advisor-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sa-modal-title-{{ block.id }}"
  >
    <div class="size-advisor-modal-content" tabindex="-1">
      <button type="button" id="size-advisor-close" class="size-advisor-close" data-i18n-aria="close" aria-label="{{ 'size_advisor.close' | t }}">&times;</button>
      <button type="button" id="sa-lang-toggle" class="sa-lang-toggle" hidden>
        <span aria-hidden="true">🌐</span><span class="sa-lang-code">ENG</span>
      </button>
      <h3 class="size-advisor-title" id="sa-modal-title-{{ block.id }}"{% if sa_modal_title == blank %} data-i18n="modal_title"{% endif %}>{% if sa_modal_title != blank %}{{ sa_modal_title }}{% else %}{{ 'size_advisor.modal_title' | t }}{% endif %}</h3>
      <p class="size-advisor-desc"{% if sa_modal_subtitle == blank %} data-i18n="modal_desc"{% endif %}>{% if sa_modal_subtitle != blank %}{{ sa_modal_subtitle }}{% else %}{{ 'size_advisor.modal_desc' | t }}{% endif %}</p>

      <div class="size-advisor-form">
        <span class="sa-label" id="sa-gender-label-{{ block.id }}" data-i18n="gender">{{ 'size_advisor.gender' | t }}</span>
        <div class="sa-pill-group sa-pill-group--2" id="sa-gender-group" role="group" aria-labelledby="sa-gender-label-{{ block.id }}">
          <button type="button" class="sa-pill-btn active" data-value="male" aria-pressed="true" data-i18n="gender_male">{{ 'size_advisor.gender_male' | t }}</button>
          <button type="button" class="sa-pill-btn" data-value="female" aria-pressed="false" data-i18n="gender_female">{{ 'size_advisor.gender_female' | t }}</button>
        </div>

        <div class="sa-grid-inputs">
          <div class="sa-input-col">
            <div class="sa-field-head">
              <label class="sa-label" for="user-height" data-i18n="height">{{ 'size_advisor.height' | t }}</label>
              <div class="sa-unit-toggle" id="sa-height-unit" role="group" aria-label="cm / in">
                <button type="button" data-unit="cm" aria-pressed="true">cm</button>
                <button type="button" data-unit="in" aria-pressed="false">in</button>
              </div>
            </div>
            <input type="number" id="user-height" inputmode="decimal" data-i18n-ph="height_ph" placeholder="{{ 'size_advisor.height_ph' | t }}" min="140" max="215">
          </div>
          <div class="sa-input-col">
            <div class="sa-field-head">
              <label class="sa-label" for="user-weight" data-i18n="weight">{{ 'size_advisor.weight' | t }}</label>
              <div class="sa-unit-toggle" id="sa-weight-unit" role="group" aria-label="kg / lb">
                <button type="button" data-unit="kg" aria-pressed="true">kg</button>
                <button type="button" data-unit="lb" aria-pressed="false">lb</button>
              </div>
            </div>
            <input type="number" id="user-weight" inputmode="decimal" data-i18n-ph="weight_ph" placeholder="{{ 'size_advisor.weight_ph' | t }}" min="40" max="180">
          </div>
        </div>

        <span class="sa-label" id="sa-body-label-{{ block.id }}" data-i18n="body">{{ 'size_advisor.body' | t }}</span>
        <div class="sa-pill-group sa-pill-group--2" id="sa-body-group" role="group" aria-labelledby="sa-body-label-{{ block.id }}">
          <button type="button" class="sa-pill-btn" data-value="slim" aria-pressed="false" data-i18n="body_slim">{{ 'size_advisor.body_slim' | t }}</button>
          <button type="button" class="sa-pill-btn active" data-value="standard" aria-pressed="true" data-i18n="body_standard">{{ 'size_advisor.body_standard' | t }}</button>
          <button type="button" class="sa-pill-btn" data-value="athletic" aria-pressed="false" data-i18n="body_athletic">{{ 'size_advisor.body_athletic' | t }}</button>
          <button type="button" class="sa-pill-btn" data-value="plus" aria-pressed="false" data-i18n="body_plus">{{ 'size_advisor.body_plus' | t }}</button>
        </div>

        <div id="sa-fit-wrap" hidden>
          <span class="sa-label" id="sa-fit-label-{{ block.id }}" data-i18n="fit">{{ 'size_advisor.fit' | t }}</span>
          <div class="sa-pill-group sa-pill-group--3" id="sa-fit-group" role="group" aria-labelledby="sa-fit-label-{{ block.id }}">
            <button type="button" class="sa-pill-btn" data-value="fitted" aria-pressed="false" data-i18n="fit_fitted">{{ 'size_advisor.fit_fitted' | t }}</button>
            <button type="button" class="sa-pill-btn active" data-value="regular" aria-pressed="true" data-i18n="fit_regular">{{ 'size_advisor.fit_regular' | t }}</button>
            <button type="button" class="sa-pill-btn" data-value="loose" aria-pressed="false" data-i18n="fit_loose">{{ 'size_advisor.fit_loose' | t }}</button>
          </div>
        </div>

        <div id="sa-garment-wrap" hidden>
          <button type="button" id="sa-garment-toggle" class="sa-garment-toggle" aria-expanded="false" aria-controls="sa-garment-fields" data-i18n="garment_toggle">
            {{ 'size_advisor.garment_toggle' | t }}
          </button>
          <div id="sa-garment-fields" class="sa-garment-fields" hidden>
            <div class="sa-grid-inputs">
              <div class="sa-input-col">
                <label class="sa-label" for="sa-ref-brand" data-i18n="garment_brand">{{ 'size_advisor.garment_brand' | t }}</label>
                <input type="text" id="sa-ref-brand" autocomplete="off" data-i18n-ph="garment_brand_ph" placeholder="{{ 'size_advisor.garment_brand_ph' | t }}">
              </div>
              <div class="sa-input-col">
                <label class="sa-label" for="sa-ref-size" data-i18n="garment_size">{{ 'size_advisor.garment_size' | t }}</label>
                <input type="text" id="sa-ref-size" autocomplete="off" data-i18n-ph="garment_size_ph" placeholder="{{ 'size_advisor.garment_size_ph' | t }}">
              </div>
            </div>
            <p class="sa-garment-hint" data-i18n="garment_hint">{{ 'size_advisor.garment_hint' | t }}</p>
          </div>
        </div>

        <button type="button" id="get-recommendation-btn">
          <span class="sa-btn-label" data-i18n="calc">{{ 'size_advisor.calc' | t }}</span>
        </button>
      </div>

      <div id="size-advisor-result" class="sa-result" role="status" aria-live="polite" hidden></div>
      <div id="sa-cart-action" class="sa-cart-action" hidden></div>
      <p id="sa-powered-by" class="sa-powered-by" hidden>Size Advisor</p>
    </div>
  </div>
</div>

<style>
  {%- if block.settings.button_font -%}
    {{ block.settings.button_font | font_face: font_display: 'swap' }}
    #sa-root-{{ block.id }} {
      --sa-btn-ff: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    }
  {%- endif -%}
  .sa-root {
    /* Wspólne zaokrąglenie — pola/pigułki/wynik idą za ustawieniem przycisku,
       ale przycięte do 16px, żeby inputy nie robiły się przesadnie okrągłe. */
    --sa-radius: clamp(0px, var(--sa-btn-radius, 8px), 16px);
    --sa-border: #d9dce1;
    --sa-muted: #6b7280;
    --sa-bg-soft: #f6f7f9;
  }
  .sa-root * { box-sizing: border-box; }
  /* Niektóre elementy mają własne `display:` (flex/inline-flex), co bije atrybut
     [hidden] z UA-stylesheet. Bez tego: wyłączenie apki nie chowa przycisku,
     przełącznik języka pokazuje się mimo braku uprawnień itd. */
  .sa-root [hidden] { display: none !important; }

  .size-advisor-container {
    margin: var(--sa-btn-space, 15px) 0;
    display: flex;
    justify-content: var(--sa-btn-justify, flex-start);
  }
  .sa-root:not(.sa-fixed-w).sa-w-full .size-advisor-trigger { width: 100%; }
  .sa-root:not(.sa-fixed-w).sa-w-inline .size-advisor-trigger { width: auto; }
  .sa-fixed-w .size-advisor-trigger { width: var(--sa-btn-w); }

  .size-advisor-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    max-width: 100%;
    background-color: var(--sa-btn-bg, #111);
    color: var(--sa-btn-fg, #fff);
    padding: var(--sa-btn-py, 13px) var(--sa-btn-px, 22px);
    border: var(--sa-btn-bw, 0px) solid var(--sa-btn-bc, #111);
    cursor: pointer;
    border-radius: var(--sa-btn-radius, 8px);
    font-family: var(--sa-btn-ff, inherit);
    font-weight: var(--sa-btn-fw, 600);
    font-size: var(--sa-btn-fs, 15px);
    line-height: 1.2;
    transition: transform 0.12s ease, box-shadow 0.16s ease, opacity 0.16s ease,
      background-color 0.16s ease, color 0.16s ease;
  }
  .size-advisor-trigger:hover {
    background-color: var(--sa-btn-bg-h, var(--sa-btn-bg, #111));
  }
  .sa-hover-fade .size-advisor-trigger:hover { opacity: 0.9; }
  .sa-hover-lift .size-advisor-trigger:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.18);
  }
  .sa-hover-shadow .size-advisor-trigger:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.22); }
  .size-advisor-trigger:active { transform: translateY(1px); }
  .sa-trigger-icon { font-size: 1.05em; }

  .size-advisor-modal {
    position: fixed;
    z-index: 2147483000;
    inset: 0;
    background-color: rgba(17,19,24,0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, visibility 0s linear 0.18s;
  }
  .size-advisor-modal.is-open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.18s ease;
  }

  .size-advisor-modal-content {
    background: #fff;
    color: #1f2430;
    padding: 26px;
    border-radius: calc(var(--sa-btn-radius, 8px) + 6px);
    max-width: 440px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 18px 50px rgba(0,0,0,0.28);
    font-family: inherit;
    transform: translateY(12px) scale(0.98);
    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
    outline: none;
    -webkit-overflow-scrolling: touch;
  }
  .size-advisor-modal.is-open .size-advisor-modal-content { transform: translateY(0) scale(1); }

  .size-advisor-close {
    position: absolute;
    right: 12px;
    top: 8px;
    width: 34px;
    height: 34px;
    font-size: 24px;
    line-height: 1;
    border: none;
    background: transparent;
    cursor: pointer;
    color: #9aa0aa;
    border-radius: 50%;
    transition: background 0.14s ease, color 0.14s ease;
  }
  .size-advisor-close:hover { background: var(--sa-bg-soft); color: #1f2430; }

  .sa-lang-toggle {
    position: absolute;
    right: 52px;
    top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 26px;
    padding: 0 8px;
    font: inherit;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #6b7280;
    background: transparent;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.14s ease, border-color 0.14s ease;
  }
  .sa-lang-toggle:hover { color: #1f2430; border-color: #d1d5db; }
  .sa-lang-code { line-height: 1; }

  .size-advisor-title { margin: 0 4px 6px 0; font-size: 20px; font-weight: 700; }
  .size-advisor-desc { margin: 0 0 16px 0; font-size: 13px; color: var(--sa-muted); line-height: 1.45; }

  .sa-label {
    display: block;
    margin: 14px 0 6px 0;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #4b5563;
  }

  .sa-pill-group { display: grid; gap: 6px; }
  .sa-pill-group--2 { grid-template-columns: repeat(2, 1fr); }
  .sa-pill-group--3 { grid-template-columns: repeat(3, 1fr); }

  .sa-pill-btn {
    padding: 10px 8px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid var(--sa-border);
    background: #fff;
    border-radius: var(--sa-radius);
    cursor: pointer;
    text-align: center;
    color: #1f2430;
    transition: border-color 0.14s ease, background 0.14s ease, color 0.14s ease, transform 0.1s ease;
  }
  .sa-pill-btn:hover { border-color: var(--sa-accent); }
  .sa-pill-btn:active { transform: translateY(1px); }
  .sa-pill-btn.active {
    background: var(--sa-accent);
    color: #fff;
    border-color: var(--sa-accent);
  }

  .sa-grid-inputs { display: flex; gap: 12px; }
  .sa-input-col { flex: 1; }

  .sa-field-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 14px 0 6px;
  }
  .sa-field-head .sa-label { margin: 0; }
  .sa-unit-toggle {
    display: inline-flex;
    flex: none;
    border: 1px solid var(--sa-border);
    border-radius: 999px;
    overflow: hidden;
  }
  .sa-unit-toggle button {
    border: 0;
    background: #fff;
    color: #6b7280;
    font: inherit;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 8px;
    line-height: 1.4;
    cursor: pointer;
    transition: background 0.14s ease, color 0.14s ease;
  }
  .sa-unit-toggle button + button { border-left: 1px solid var(--sa-border); }
  .sa-unit-toggle button.active { background: var(--sa-accent); color: #fff; }
  .sa-input-col input {
    width: 100%;
    padding: 11px 12px;
    font-size: 15px;
    border: 1px solid var(--sa-border);
    border-radius: var(--sa-radius);
    background: #fff;
    color: #1f2430;
    transition: border-color 0.14s ease, box-shadow 0.14s ease;
  }
  .sa-input-col input:focus {
    outline: none;
    border-color: var(--sa-accent);
    box-shadow: 0 0 0 3px rgba(17,19,24,0.08);
  }

  #sa-garment-wrap { margin-top: 14px; }
  .sa-garment-toggle {
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    color: var(--sa-accent);
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .sa-garment-toggle::after {
    content: "›";
    display: inline-block;
    transition: transform 0.15s ease;
    font-size: 15px;
  }
  .sa-garment-toggle[aria-expanded="true"]::after { transform: rotate(90deg); }
  .sa-garment-fields { margin-top: 8px; }
  .sa-garment-hint { margin: 6px 0 0; font-size: 12px; color: var(--sa-muted); line-height: 1.4; }

  #get-recommendation-btn {
    position: relative;
    width: 100%;
    padding: 13px;
    margin-top: 18px;
    background: var(--sa-accent);
    color: #fff;
    border: none;
    border-radius: var(--sa-radius);
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.16s ease, transform 0.1s ease;
  }
  #get-recommendation-btn:hover { opacity: 0.92; }
  #get-recommendation-btn:active { transform: translateY(1px); }
  #get-recommendation-btn[disabled] { opacity: 0.75; cursor: default; }
  #get-recommendation-btn.is-loading .sa-btn-label { visibility: hidden; }
  #get-recommendation-btn.is-loading::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border: 2px solid rgba(255,255,255,0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: sa-spin 0.7s linear infinite;
  }
  @keyframes sa-spin { to { transform: rotate(360deg); } }

  .sa-result {
    margin-top: 18px;
    padding: 13px 15px;
    border-radius: var(--sa-radius);
    background: var(--sa-bg-soft);
    border-left: 4px solid var(--sa-accent);
    font-size: 14px;
    line-height: 1.45;
    animation: sa-fade-in 0.22s ease both;
  }
  .sa-result--loading { color: var(--sa-muted); display: flex; align-items: center; gap: 9px; }
  .sa-result--loading::before {
    content: "";
    width: 15px; height: 15px;
    border: 2px solid var(--sa-border);
    border-top-color: var(--sa-accent);
    border-radius: 50%;
    animation: sa-spin 0.7s linear infinite;
    flex: none;
  }
  .sa-result--ok .sa-result-size { font-size: 16px; font-weight: 700; }
  .sa-result--ok .sa-result-why { color: #4b5563; font-size: 13px; margin-top: 5px; display: block; }

  /* Skala dopasowania = progress bar: tor z wypełnieniem rosnącym do pinezki
     „Ty", pod spodem stałe komórki rozmiarów. Pozycja z `fitScale.pos` (silnik
     interpoluje ją płynnie, więc pinezka nie przeskakuje przy zmianie rozmiaru). */
  .sa-fit-scale { margin-top: 16px; }
  .sa-fit-ends {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sa-muted);
  }
  .sa-fit-tw { position: relative; padding-top: 22px; }
  .sa-fit-track {
    position: relative;
    height: 6px;
    border-radius: 999px;
    background: var(--sa-border);
    overflow: hidden;
  }
  .sa-fit-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    border-radius: 999px;
    background: var(--sa-accent);
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--sa-accent) 12%, transparent),
      var(--sa-accent)
    );
  }
  .sa-fit-tick {
    position: absolute;
    top: 0;
    height: 100%;
    width: 2px;
    transform: translateX(-50%);
    background: #fff;
    opacity: 0.8;
  }
  .sa-fit-pin {
    position: absolute;
    bottom: 6px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }
  .sa-fit-pin-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--sa-accent);
    border-radius: 999px;
    padding: 2px 7px;
    line-height: 1.3;
    white-space: nowrap;
  }
  .sa-fit-pin::after {
    content: "";
    width: 0;
    height: 0;
    margin-top: 1px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid var(--sa-accent);
  }
  .sa-fit-cells { display: flex; gap: 6px; margin-top: 8px; }
  .sa-fit-cell {
    flex: 1;
    text-align: center;
    padding: 6px 4px;
    border: 1px solid var(--sa-border);
    border-radius: var(--sa-radius);
    background: #fff;
    font-size: 13px;
    font-weight: 600;
    color: var(--sa-muted);
  }
  .sa-fit-cell--rec {
    color: #1f2430;
    font-weight: 700;
    border-color: var(--sa-accent);
    background: color-mix(in srgb, var(--sa-accent) 10%, #fff);
  }

  .sa-result--err {
    background: #fef2f2;
    border-left-color: #dc2626;
    color: #b42318;
  }
  @keyframes sa-fade-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .sa-cart-action { margin-top: 14px; animation: sa-cart-in 0.28s cubic-bezier(0.2, 0.8, 0.3, 1) both; }
  @keyframes sa-cart-in { from { opacity: 0; transform: translateY(8px) scale(0.97); } to { opacity: 1; transform: none; } }
  .sa-add-to-cart {
    position: relative;
    width: 100%;
    padding: 14px;
    background: var(--sa-accent);
    color: #fff;
    border: none;
    border-radius: var(--sa-radius);
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    overflow: hidden;
    transition: opacity 0.16s ease, transform 0.1s ease, box-shadow 0.2s ease;
    animation: sa-cart-glow 2s ease-out 1;
  }
  /* delikatny błysk – smuga światła przejeżdża raz po przycisku */
  .sa-add-to-cart::after {
    content: "";
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.35), transparent);
    transform: skewX(-18deg);
    animation: sa-cart-shine 1.15s ease-out 0.25s 1;
  }
  @keyframes sa-cart-shine {
    from { left: -60%; }
    to { left: 130%; }
  }
  @keyframes sa-cart-glow {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--sa-accent) 45%, transparent); }
    70% { box-shadow: 0 0 0 12px color-mix(in srgb, var(--sa-accent) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .sa-add-to-cart:hover { opacity: 0.94; box-shadow: 0 4px 14px color-mix(in srgb, var(--sa-accent) 35%, transparent); }
  .sa-add-to-cart:active { transform: translateY(1px); }
  .sa-add-to-cart:disabled { opacity: 0.6; cursor: default; animation: none; box-shadow: none; }
  .sa-add-to-cart:disabled::after { display: none; }
  .sa-cart-note { font-size: 13px; color: #4b5563; line-height: 1.45; margin: 8px 0 0; }
  @media (prefers-reduced-motion: reduce) {
    .sa-cart-action, .sa-add-to-cart { animation: none !important; }
    .sa-add-to-cart::after { display: none; }
  }
  .sa-cart-done { font-size: 14px; font-weight: 700; color: #047857; margin: 0; }
  .sa-cart-done a { display: inline-block; margin-top: 4px; font-weight: 600; color: var(--sa-accent); }

  .sa-powered-by {
    margin: 14px 0 0 0;
    text-align: center;
    font-size: 10px;
    font-weight: 600;
    color: #b6bcc6;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  @media (max-width: 400px) {
    .size-advisor-modal-content { padding: 22px 18px; }
    .sa-pill-btn { padding: 10px 4px; font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sa-root *, .size-advisor-modal, .size-advisor-modal-content { transition: none !important; animation: none !important; }
  }

  body.sa-scroll-lock { overflow: hidden; }
</style>

